PORT=4321
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string
SITE_URL=
TRUST_PROXY=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Push-notifikation til din telefon ved ny booking og betaling. Installer appen ntfy og abonnér
# på samme navn. Navnet er hemmeligt – gør det langt og tilfældigt.
NTFY_TOPIC=

# Mail til kunden (resend.com, gratis op til 3.000 om måneden). MAIL_FROM skal bruge et domæne,
# du har bekræftet i Resend, fx: TeknikFix <booking@teknikfix.dk>
RESEND_API_KEY=
MAIL_FROM=
# SMS til kunden (gatewayapi.com, ca. 0,25 kr pr. sms). Afsender må højst være 11 tegn.
GATEWAYAPI_TOKEN=
SMS_SENDER=TeknikFix
